# GEMINI_API_KEY: Server-only. Required for live Ask KanakkuX answers.
# Leave unset in development to use labeled mock/demo replies.
# Never expose this key in client-side code or commit a real key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Optional. New AI Studio keys (AQ.… auth keys) work with x-goog-api-key.
# Restart `npm run dev` after changing this file.
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Cloudinary Configuration (Receipt Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
